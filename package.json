{
  "name": "subagent-gateway-dev",
  "private": true,
  "description": "Git hooks only. The plugin itself has no dependencies; this file exists so lefthook and commitlint run the hookset presets.",
  "scripts": {
    "prepare": "lefthook install || true",
    "hook:staged": "sh -c 'node --experimental-strip-types scripts/agents.mjs --check' hook-staged",
    "hook:verify": "npm run lint:guidance && claude plugin validate --strict . && claude plugin test .",
    "hook:test-integrity": "npx truepass diff --base origin/main",
    "lint:guidance": "eslint --config eslint.guidance.config.mjs --no-warn-ignored --suppressions-location .guidance-suppressions.json .",
    "hook:provedone": "provedone gate --mode enforce",
    "hook:triggerlist": "triggerlist protect origin/main"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@eslint/markdown": "^7.5.1",
    "eslint": "^10.15.0",
    "eslint-plugin-conventions": "^7.2.1",
    "lefthook": "^2.2.2",
    "provedone": "^1.0.0",
    "triggerlist": "^1.0.0",
    "truepass": "^1.0.0"
  }
}
